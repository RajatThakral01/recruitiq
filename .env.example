DATABASE_URL=postgresql://recruitiq:recruitiq@localhost:5432/recruitiq
LLM_PROVIDER=mistral
SCORING_MODE=llm_first
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=10
MAX_RESUMES=10
CORS_ORIGINS=*
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1.5
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-large-latest
GROK_API_KEY=your_grok_or_openrouter_key_here
GROK_BASE_URL=https://openrouter.ai/api/v1
GROK_MODEL=arcee-ai/trinity-large-preview:free
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
